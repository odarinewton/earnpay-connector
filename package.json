{
  "name": "earnpay-connector",
  "version": "1.0.0",
  "description": "Generic TypeScript connector for EarnPay wallet, escrow, work, earnings, FX, payout, and agent settlement flows.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "earnpay",
    "payments",
    "escrow",
    "wallet",
    "fx",
    "mpesa",
    "typescript",
    "work",
    "earnings",
    "agents",
    "settlement"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  }
}
