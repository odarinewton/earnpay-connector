{
  "name": "earnpay-connector",
  "version": "1.0.0",
  "description": "Generic TypeScript adapter for EarnPay wallet, escrow, FX, and payout flows.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "earnpay",
    "payments",
    "escrow",
    "wallet",
    "fx",
    "mpesa",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  }
}
